apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.Name}}
  namespace: {{.Namespace}}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{.Name}}
  template:
    metadata:
      labels:
        app: {{.Name}}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      terminationGracePeriodSeconds: 30
      containers:
        - name: object-storage
          image: {{ .Image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          ports:
            - name: grpc
              containerPort: 9464
          env:
            - name: SOS_LISTEN
              value: ":9464"
            - name: SOS_BACKEND
              value: "{{ .Deployment.Parameters.Backend }}"
            - name: SOS_BUCKET
              value: "{{ .Deployment.Parameters.Bucket }}"
            - name: SOS_REGION
              value: "{{ .Deployment.Parameters.Region }}"
{{- if and (eq .Deployment.Parameters.Backend "gcs") (not .Restricted) }}
            # GCS authenticates from a service-account JSON file on disk, so the
            # secret's SOS_GCS_CREDENTIALS_JSON key is mounted as a file below and
            # this points the gateway at it. S3/Azure take credential values via
            # envFrom instead.
            - name: SOS_GCS_CREDENTIALS_FILE
              value: "/var/secrets/gcs/credentials.json"
{{- end }}
{{- if not .Restricted }}
          envFrom:
            - secretRef:
                name: {{.Name}}-secret
{{- end }}
{{- if and (eq .Deployment.Parameters.Backend "gcs") (not .Restricted) }}
          volumeMounts:
            - name: gcs-credentials
              mountPath: /var/secrets/gcs
              readOnly: true
{{- end }}
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: "1"
              memory: 512Mi
          startupProbe:
            tcpSocket:
              port: 9464
            periodSeconds: 2
            failureThreshold: 30
          readinessProbe:
            tcpSocket:
              port: 9464
            periodSeconds: 5
            timeoutSeconds: 3
          livenessProbe:
            tcpSocket:
              port: 9464
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
{{- if and (eq .Deployment.Parameters.Backend "gcs") (not .Restricted) }}
      volumes:
        - name: gcs-credentials
          secret:
            secretName: {{.Name}}-secret
            items:
              - key: SOS_GCS_CREDENTIALS_JSON
                path: credentials.json
{{- end }}
