apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.Name}}
  namespace: {{.Namespace}}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{.Name}}
  template:
    metadata:
      labels:
        app: {{.Name}}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      terminationGracePeriodSeconds: 30
      containers:
        - name: object-storage
          image: {{ .Image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          ports:
            - name: grpc
              containerPort: 9464
          env:
            - name: SOS_LISTEN
              value: ":9464"
            - name: SOS_BACKEND
              value: "{{ .Deployment.Parameters.Backend }}"
            - name: SOS_BUCKET
              value: "{{ .Deployment.Parameters.Bucket }}"
            - name: SOS_REGION
              value: "{{ .Deployment.Parameters.Region }}"
            # The gateway refuses to start on an unauthenticated listener unless
            # this is set. In the deployed profile caller identity is enforced by
            # the cluster — NetworkPolicy plus service-mesh mTLS in front of this
            # ClusterIP — not by the gateway.
            #
            # Do not replace this with SOS_AUTH_TOKEN on its own. The gateway
            # would then enforce a credential its consumers do not have, because
            # nothing delivers that secret to their object-storage
            # configuration. Both halves have to land together; see README
            # "Authentication".
            - name: SOS_ALLOW_ANONYMOUS
              value: "true"
{{- /* GCS renders no SOS_GCS_CREDENTIALS_FILE: nothing here mounts a
service-account key, so a path would name a file the pod does not have.
Deployed GCS authenticates via Workload Identity, or via a key an overlay
outside this agent mounts and patches the env var for; Deploy rejects a
configured key-file path rather than emit one. Kept as a template comment:
rendering it as YAML would ship GCS prose into every s3/azure manifest. */}}
{{- if and (eq .Deployment.Parameters.Backend "azure") .Deployment.Parameters.AzureAccount }}
            # Azure Blob storage account name. Non-sensitive (it is the public
            # blob endpoint host), so it is emitted for restricted output too;
            # the paired shared key (SOS_AZURE_KEY) is sensitive and arrives via
            # the Secret / envFrom path, never as a literal here.
            - name: SOS_AZURE_ACCOUNT
              value: "{{ .Deployment.Parameters.AzureAccount }}"
{{- end }}
{{- if not .Restricted }}
          envFrom:
            - secretRef:
                name: {{.Name}}-secret
{{- end }}
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: "1"
              memory: 512Mi
          startupProbe:
            tcpSocket:
              port: 9464
            periodSeconds: 2
            failureThreshold: 30
          readinessProbe:
            tcpSocket:
              port: 9464
            periodSeconds: 5
            timeoutSeconds: 3
          livenessProbe:
            tcpSocket:
              port: 9464
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
